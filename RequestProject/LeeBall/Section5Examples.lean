module

public import RequestProject.LeeBall.Section5Prop
public import RequestProject.LeeBall.Section4Examples
public import RequestProject.LeeBall.Computational

/-!
# Section 5: Qureshi's formula for `c_{(k)}` and the worked examples of Section 5

* Qureshi's formula `c_{(k)} = 2 ∑_{i=0}^{r} (r-i)^{2k-1} |Bⁿ(i)|` (Section 1);
* a nonexistence criterion combining Proposition 5.11 (vanishing part) with Lemma 5.4: if the
  index `h = (p-1)/2` is not in the monoid `B` generated by the "bad" indices, then
  `S_{p-1} = -m / c_{(h)}` is forced, and if this value is not one of `0, 1, …, n` there is no
  tiling;
* Example 5.2 (`n = 7`, `r = 3`, `p = 23`), Example 5.3 (`n = 26`, `r = 3`, `p = 67`) and
  Example 5.10 (`n = 13`, `r = 3`, `p = 367`): all the needed values of `c_{(k)} mod p` are checked
  by direct computation in Lean;
* Example 5.7 (`n = 80`, `r = 3`, `p = 149`): one unknown `u = S_{82}`; Theorem 5.8 is checked for
  all `149` values of `u`;
* Example 5.6 (`n = 79`, `r = 3`, `p = 269`): via Newton's identities and Lemma 5.5;
* the ball sizes quoted in Proposition 5.12 and Example 5.13.
-/

@[expose] public section

open Finset

namespace LeeBall

/-- Computable right-hand side of Qureshi's formula: `∑_{i=0}^{r} (r-i)^{2k-1} |Bⁿ(i)|`. -/
def qureshiSum (n r k : ℕ) : ℕ :=
  ∑ i ∈ range (r + 1), (r - i) ^ (2 * k - 1) * scFast n i

/-- **Qureshi's formula** for the coefficient of `s_{2k}`:
`c_{(k)} = 2 ∑_{i=0}^{r} (r-i)^{2k-1} |Bⁿ(i)|` for `k ≥ 1`. -/
theorem cInt_indiscrete {n r k : ℕ} (hk : 1 ≤ k) :
    cInt n r (Nat.Partition.indiscrete k) =
      2 * ∑ i ∈ range (r + 1), (((r - i : ℕ) : ℤ) ^ (2 * k - 1) * (leeBall n i).card) := by
  rw [cInt, partList, Nat.Partition.indiscrete_parts (by omega), Multiset.sort_singleton]
  have hb : (Multiset.map (fun x => 2 * x) {k}).bell = 1 := by
    simp [Multiset.bell, Nat.multinomial, Nat.div_self (Nat.factorial_pos _)]
    intro i _ hi j hj
    subst hi
    simp at hj
    subst hj
    simp
  rw [hb, Multiset.card_singleton, compSum, Finset.mul_sum]
  unfold compositions
  rw [Finset.sum_filter]
  simp only [List.length_singleton]
  rw [sum_antidiagonalTuple_succ]
  simp only [Finset.Nat.antidiagonalTuple_one, Finset.sum_singleton, Fin.prod_univ_one,
    Fin.forall_fin_one]
  have key : ∀ f : ℕ × ℕ → ℕ, (∀ x, f x = #(leeBall n x.2) * x.1 ^ (2 * k - 1)) →
      ∑ x ∈ antidiagonal r, f x = ∑ i ∈ range (r + 1), (r - i) ^ (2 * k - 1) * #(leeBall n i) := by
    intro f hf
    rw [Finset.sum_congr rfl fun x _ => hf x, ← Finset.Nat.sum_antidiagonal_swap]
    simp only [Prod.fst_swap, Prod.snd_swap]
    rw [Finset.Nat.sum_antidiagonal_eq_sum_range_succ
        (fun a b => #(leeBall n a) * b ^ (2 * k - 1))]
    exact Finset.sum_congr rfl fun i _ => mul_comm _ _
  rw [key _ fun x => ?_]
  · push_cast
    rw [Finset.mul_sum]
  · split_ifs with h
    · rfl
    · simp only [Fin.castSucc_zero, Fin.cons_zero] at h
      simp [show x.1 = 0 by omega, zero_pow (show 2 * k - 1 ≠ 0 by omega)]

lemma cInt_indiscrete_eq_qureshiSum {n r k : ℕ} (hk : 1 ≤ k) :
    cInt n r (Nat.Partition.indiscrete k) = ((2 * qureshiSum n r k : ℕ) : ℤ) := by
  rw [cInt_indiscrete hk, qureshiSum]
  push_cast
  simp [card_leeBall, stantonCowan_eq_scFast]

/-- Nonexistence criterion (Proposition 5.11 + Lemma 5.4).  If `h = (p-1)/2 ∉ B` and
`-m / c_{(h)}` is not congruent to any of `0, 1, …, n`, there is no lattice tiling. -/
theorem no_tiling_of_last_forced {n r m p : ℕ} [Fact p.Prime] (hp2 : 2 < p)
    (hB : (leeBall n r).card = m * p) (hh : (p - 1) / 2 ∉ badMonoid n r p)
    (hval : ∀ t ≤ n,
      -(m : ZMod p) / (cInt n r (Nat.Partition.indiscrete ((p - 1) / 2)) : ZMod p) ≠ t) :
    ¬ HasLatticeTiling (leeBall n r) := by
  refine no_tiling_of_S_pred hp2 hB fun Y hY t ht => ?_
  rw [(ySystem_vanish hY _ (by omega) le_rfl hh).2 rfl]
  exact hval t ht

lemma cInt_indiscrete_cast_eq {n r p k : ℕ} (hk : 1 ≤ k) :
    (cInt n r (Nat.Partition.indiscrete k) : ZMod p) = ((2 * qureshiSum n r k % p : ℕ) : ZMod p) := by
  rw [cInt_indiscrete_eq_qureshiSum hk, Int.cast_natCast, ZMod.natCast_mod]

/-- If every "bad" index `k ≤ h` (with `c_{(k)} ≡ 0 mod p`) is a multiple of `d`, then so is every
element of the monoid `B` they generate. -/
lemma dvd_of_mem_badMonoid {n r p d : ℕ} [Fact p.Prime] (hp2 : 2 < p)
    (hbad : ∀ k ∈ Finset.Icc 1 ((p - 1) / 2), ¬ d ∣ k → 2 * qureshiSum n r k % p ≠ 0) {k : ℕ}
    (hk : k ∈ badMonoid n r p) : d ∣ k := by
  have hle : badMonoid n r p ≤ AddSubmonoid.multiples d := by
    refine AddSubmonoid.closure_le.2 fun k ⟨hk1, hkh, hk0⟩ => ?_
    have hdk : d ∣ k := by
      by_contra hdk
      refine hbad k (Finset.mem_Icc.2 ⟨hk1, hkh⟩) hdk ?_
      rw [cInt_indiscrete_cast_eq hk1, ZMod.natCast_eq_zero_iff] at hk0
      exact Nat.eq_zero_of_dvd_of_lt hk0 (Nat.mod_lt _ (by omega))
    obtain ⟨j, rfl⟩ := hdk
    exact ⟨j, by simp [mul_comm]⟩
  obtain ⟨j, hj⟩ := hle hk
  exact ⟨j, by rw [← hj]; simp [mul_comm]⟩

/-- Computable form of `no_tiling_of_last_forced`: the "bad" indices `k ≤ h` (those with
`c_{(k)} ≡ 0`) are all multiples of `d`, `h` is not a multiple of `d`, and
`-m / c_{(h)} ∉ {0, …, n}` in `𝔽_p`. -/
theorem no_tiling_of_qureshi {n r m p d c0 : ℕ} [Fact p.Prime] (hp2 : 2 < p)
    (hB : (leeBall n r).card = m * p)
    (hbad : ∀ k ∈ Finset.Icc 1 ((p - 1) / 2), ¬ d ∣ k → 2 * qureshiSum n r k % p ≠ 0)
    (hd : ¬ d ∣ (p - 1) / 2) (hc0 : 2 * qureshiSum n r ((p - 1) / 2) % p = c0)
    (hval : ∀ t ∈ Finset.range (n + 1), -(m : ZMod p) / (c0 : ZMod p) ≠ t) :
    ¬ HasLatticeTiling (leeBall n r) := by
  refine no_tiling_of_last_forced hp2 hB (fun hh => hd (dvd_of_mem_badMonoid hp2 hbad hh))
    fun t ht => ?_
  · rw [cInt_indiscrete_cast_eq (by omega), hc0]
    exact hval t (Finset.mem_range.2 (by omega))

/-! ### Example 5.2: `(n, r) = (7, 3)`, `p = 23` -/

instance fact_prime_23 : Fact (Nat.Prime 23) := ⟨by norm_num⟩

/-- `|B⁷(3)| = 575 = 25 · 23`. -/
theorem card_leeBall_7_3 : (leeBall 7 3).card = 25 * 23 := by
  rw [card_leeBall, stantonCowan_eq_scFast]; decide

/-- **Example 5.2** (with Lemma 5.4).  For `p = 23`, every `c_{(k)}` (`1 ≤ k ≤ 11`) is nonzero
mod `23`, so `𝒮 = (0, …, 0, S_{22})` with `S_{22} = 11 ∉ {0, …, 7}`: there is no lattice tiling of
`ℤ⁷` by `B⁷(3)`. -/
theorem no_tiling_7_3 : ¬ HasLatticeTiling (leeBall 7 3) := by
  refine no_tiling_of_qureshi (p := 23) (d := 12) (c0 := 2 * qureshiSum 7 3 11 % 23)
    (by norm_num) card_leeBall_7_3 (by decide +kernel) (by decide) rfl (by decide +kernel)

/-! ### Example 5.3: `(n, r) = (26, 3)`, `p = 67` -/

instance fact_prime_67 : Fact (Nat.Prime 67) := ⟨by norm_num⟩

/-- `|B²⁶(3)| = 24857 = 371 · 67`. -/
theorem card_leeBall_26_3 : (leeBall 26 3).card = 371 * 67 := by
  rw [card_leeBall, stantonCowan_eq_scFast]; decide

/-- **Example 5.3** (with Lemma 5.4).  For `p = 67` the only `k ≤ 33` with `c_{(k)} ≡ 0 (mod 67)`
are multiples of `15` (namely `k = 15`), and `33` is not a sum of such indices; hence
`S_{66} = -m / c_{(33)} = 33 ∉ {0, …, 26}` and there is no lattice tiling of `ℤ²⁶` by `B²⁶(3)`. -/
theorem no_tiling_26_3 : ¬ HasLatticeTiling (leeBall 26 3) :=
  no_tiling_of_qureshi (p := 67) (d := 15) (c0 := 2 * qureshiSum 26 3 33 % 67)
    (by norm_num) card_leeBall_26_3 (by decide +kernel) (by decide) rfl (by decide +kernel)

/-- In Example 5.3, `c_{(15)} ≡ 0 (mod 67)`, so `S_{30}` is not determined by the system. -/
theorem c15_26_3_zero : (cInt 26 3 (Nat.Partition.indiscrete 15) : ZMod 67) = 0 := by
  rw [cInt_indiscrete_cast_eq (by norm_num)]; decide +kernel

/-! ### Example 5.10: `(n, r) = (13, 3)`, `p = 367` -/

instance fact_prime_367 : Fact (Nat.Prime 367) := ⟨by norm_num⟩

/-- `|B¹³(3)| = 3303 = 9 · 367`. -/
theorem card_leeBall_13_3 : (leeBall 13 3).card = 9 * 367 := by
  rw [card_leeBall, stantonCowan_eq_scFast]; decide

/-- **Example 5.10.**  For `p = 367` every `c_{(k)}`, `1 ≤ k ≤ 183`, is nonzero mod `367`, so
`𝒮 = (0, …, 0, S_{366})`.  The manuscript concludes with Theorem 5.9; here we use the forced value
`S_{366} = 103 ∉ {0, …, 13}` and Lemma 5.4.  There is no lattice tiling of `ℤ¹³` by `B¹³(3)`. -/
theorem no_tiling_13_3 : ¬ HasLatticeTiling (leeBall 13 3) :=
  no_tiling_of_qureshi (p := 367) (d := 184) (c0 := 2 * qureshiSum 13 3 183 % 367)
    (by norm_num) card_leeBall_13_3 (by decide +kernel) (by decide) rfl (by decide +kernel)

/-! ### One undetermined entry: Theorem 5.8 applied to all values of the unknown -/

/-- The candidate sequence `𝒮` with one unknown `u` at index `j` and the forced value `v` at
`h = (p-1)/2`, all other entries zero. -/
def oneUnknownSeq (p j : ℕ) (u v : ZMod p) (k : ℕ) : ZMod p :=
  if k = j then u else if k = (p - 1) / 2 then v else 0

/-- Nonexistence criterion used in Example 5.7 (Proposition 5.11 + Theorem 5.8).  Suppose the bad
indices are multiples of `d`, `h ∤ d`, and `j < h` is the only multiple of `d` in `[1, h-1]`.  Then
`𝒮 = (0, …, 0, u, 0, …, 0, -m/c_{(h)})` with `u = S_{2j}` unknown.  If for every `u ∈ 𝔽_p` the
canonical representatives of `𝓖` sum to more than `n`, there is no lattice tiling. -/
theorem no_tiling_of_one_unknown {n r m p d j c0 : ℕ} [Fact p.Prime] (hp2 : 2 < p)
    (hB : (leeBall n r).card = m * p)
    (hbad : ∀ k ∈ Finset.Icc 1 ((p - 1) / 2), ¬ d ∣ k → 2 * qureshiSum n r k % p ≠ 0)
    (hd : ¬ d ∣ (p - 1) / 2) (hj : ∀ k ∈ Finset.Icc 1 ((p - 1) / 2 - 1), d ∣ k → k = j)
    (hjh : j < (p - 1) / 2) (hc0 : 2 * qureshiSum n r ((p - 1) / 2) % p = c0)
    (hG : ∀ u : ZMod p, n < ∑ i ∈ Finset.Icc 1 ((p - 1) / 2),
      (gSeq p (oneUnknownSeq p j u (-(m : ZMod p) / (c0 : ZMod p))) i).val) :
    ¬ HasLatticeTiling (leeBall n r) := by
  refine no_tiling_of_sum_gSeq hp2 hB fun Y hY => ?_
  have hYk : ∀ k ∈ Finset.Icc 1 ((p - 1) / 2),
      Y k = oneUnknownSeq p j (Y j) (-(m : ZMod p) / (c0 : ZMod p)) k := by
    intro k hk
    rw [Finset.mem_Icc] at hk
    unfold oneUnknownSeq
    by_cases hkj : k = j
    · rw [if_pos hkj, hkj]
    rw [if_neg hkj]
    by_cases hkh : k = (p - 1) / 2
    · rw [if_pos hkh, (ySystem_vanish hY k hk.1 hk.2 (fun hB' => hd (hkh ▸
        dvd_of_mem_badMonoid hp2 hbad hB'))).2 hkh, hkh, cInt_indiscrete_cast_eq (by omega), hc0]
    · rw [if_neg hkh]
      refine (ySystem_vanish hY k hk.1 hk.2 fun hB' => hkj ?_).1 (by omega)
      exact hj k (Finset.mem_Icc.2 ⟨hk.1, by omega⟩) (dvd_of_mem_badMonoid hp2 hbad hB')
  have hg : ∀ i, gSeq p Y i = gSeq p (oneUnknownSeq p j (Y j) (-(m : ZMod p) / (c0 : ZMod p))) i := by
    intro i
    unfold gSeq
    rw [Finset.sum_congr rfl fun k hk => by rw [hYk k hk]]
  simp only [hg]
  exact hG (Y j)

/-- Closed form of `𝓖` for the sequence `oneUnknownSeq`. -/
lemma gSeq_oneUnknownSeq {p j : ℕ} [Fact p.Prime] (hj1 : 1 ≤ j) (hjh : j < (p - 1) / 2)
    (u v : ZMod p) (i : ℕ) :
    gSeq p (oneUnknownSeq p j u v) i =
      -2 * (u / (i : ZMod p) ^ (2 * j) + v / (i : ZMod p) ^ (2 * ((p - 1) / 2))) := by
  unfold gSeq oneUnknownSeq
  congr 1
  have hjm : j ∈ Finset.Icc 1 ((p - 1) / 2) := Finset.mem_Icc.2 ⟨hj1, hjh.le⟩
  have hhm : (p - 1) / 2 ∈ Finset.Icc 1 ((p - 1) / 2) := Finset.mem_Icc.2 ⟨by omega, le_rfl⟩
  rw [← Finset.add_sum_erase _ _ hjm, if_pos rfl,
    ← Finset.add_sum_erase _ _ (Finset.mem_erase.2 ⟨by omega, hhm⟩), if_neg (by omega),
    if_pos rfl, Finset.sum_eq_zero, add_zero]
  intro k hk
  simp only [Finset.mem_erase] at hk
  rw [if_neg hk.2.1, if_neg hk.1, zero_div]

/-! ### Example 5.7: `(n, r) = (80, 3)`, `p = 149` -/

instance fact_prime_149 : Fact (Nat.Prime 149) := ⟨by norm_num⟩

/-- `|B⁸⁰(3)| = 695681 = 4669 · 149`. -/
theorem card_leeBall_80_3 : (leeBall 80 3).card = 4669 * 149 := by
  rw [card_leeBall, stantonCowan_eq_scFast]; decide

/-- **Example 5.7.**  For `p = 149` the only bad index `k ≤ 74` is `k = 41`, so
`𝒮 = (0, …, 0, u, 0, …, 0, 63)` (`u = S_{82}` at position `41`).  For every `u ∈ 𝔽₁₄₉` the
canonical representatives of `𝓖` sum to more than `80`, so by Theorem 5.8 there is no lattice
tiling of `ℤ⁸⁰` by `B⁸⁰(3)`. -/
theorem no_tiling_80_3 : ¬ HasLatticeTiling (leeBall 80 3) :=
  no_tiling_of_one_unknown (p := 149) (d := 41) (j := 41) (c0 := 2 * qureshiSum 80 3 74 % 149)
    (by norm_num) card_leeBall_80_3 (by decide +kernel) (by decide) (by decide) (by norm_num) rfl
    (by simp only [gSeq_oneUnknownSeq (p := 149) (j := 41) (by norm_num) (by norm_num)]
        decide +kernel)

/-! ### Example 5.6: `(n, r) = (79, 3)`, `p = 269` (via Lemma 5.5) -/

/-- If `S_{2i}(x) = 0` for all `1 ≤ i ≤ N` with `d ∤ i`, and `N < p`, then `e_k(x²) = 0` for all
`k ≤ N` with `d ∤ k` (Newton's identities). -/
lemma esymmSq_eq_zero_of_not_dvd {n p : ℕ} [Fact p.Prime] (x : Fin n → ZMod p) {d N : ℕ}
    (hN : N < p) (hS : ∀ i, 1 ≤ i → i ≤ N → ¬ d ∣ i → ∑ j, x j ^ (2 * i) = 0) :
    ∀ k, k ≤ N → ¬ d ∣ k → esymmSq x k = 0 := by
  intro k
  induction k using Nat.strong_induction_on with
  | _ k ih =>
    intro hkN hdk
    have hk0 : k ≠ 0 := by rintro rfl; exact hdk (dvd_zero d)
    have hkp : (k : ZMod p) ≠ 0 := by
      rw [Ne, ZMod.natCast_eq_zero_iff]
      exact Nat.not_dvd_of_pos_of_lt (by omega) (by omega)
    have h := newton_esymmSq x k
    rw [Finset.sum_eq_zero] at h
    · exact (mul_eq_zero.1 h).resolve_left hkp
    intro i hi
    rw [Finset.mem_Icc] at hi
    by_cases hdi : d ∣ i
    · have hdki : ¬ d ∣ k - i := fun h' => hdk (by
        have := Nat.dvd_add h' hdi; rwa [Nat.sub_add_cancel hi.2] at this)
      rw [ih (k - i) (by omega) (by omega) hdki, mul_zero]
    · rw [hS i hi.1 (by omega) hdi, mul_zero, zero_mul]

instance fact_prime_269 : Fact (Nat.Prime 269) := ⟨by norm_num⟩

/-- `|B⁷⁹(3)| = 2491 · 269`. -/
theorem card_leeBall_79_3 : (leeBall 79 3).card = 2491 * 269 := by
  rw [card_leeBall, stantonCowan_eq_scFast]; decide

/-- **Example 5.6.**  For `p = 269` all bad indices `k ≤ 134` are multiples of `20`, so
`S_{2i} = 0` unless `20 ∣ i`; by Newton's identities `e_k(x²) = 0` unless `20 ∣ k`, hence
`e_{61}(x²) = ⋯ = e_{79}(x²) = 0` and `τ(𝓔_{≤79}) ≥ 19`.  Since `|B¹⁹(3)| = 9919 > m = 2491`,
Lemma 5.5 shows that there is no lattice tiling of `ℤ⁷⁹` by `B⁷⁹(3)`.  (This argument does not
need the explicit values of the entries depending on the unknown `u`.) -/
theorem no_tiling_79_3 : ¬ HasLatticeTiling (leeBall 79 3) := by
  intro ht
  obtain ⟨x, hx⟩ := exists_tilingImage_of_tiling card_leeBall_79_3 ht
  have hY := hx.ySystem (p := 269) (by norm_num)
  have hbad : ∀ k ∈ Finset.Icc 1 ((269 - 1) / 2), ¬ 20 ∣ k → 2 * qureshiSum 79 3 k % 269 ≠ 0 := by
    decide +kernel
  have hS : ∀ i, 1 ≤ i → i ≤ 79 → ¬ 20 ∣ i → ∑ j, x j ^ (2 * i) = 0 := fun i hi1 hi hdi =>
    (ySystem_vanish hY i hi1 (by norm_num; omega)
      (fun hB => hdi (dvd_of_mem_badMonoid (by norm_num) hbad hB))).1 (by norm_num; omega)
  have he := esymmSq_eq_zero_of_not_dvd x (d := 20) (N := 79) (by norm_num) hS
  have htau : 19 ≤ tauE x := by
    unfold tauE
    refine Nat.le_findGreatest (by norm_num) fun j hj1 hj2 => he j hj2 ?_
    omega
  have h1 := card_leeBall_tauE_le hx
  have h2 := card_leeBall_mono (r := 3) (r' := 3) htau le_rfl
  have h3 : (leeBall 19 3).card = 9919 := by
    rw [card_leeBall, stantonCowan_eq_scFast]; decide
  omega

/-! ### The forced values `S_{p-1} = -m / c_{(h)}` agree with the manuscript -/

/-- Example 5.2: `S_{22} = -25 / c_{(11)} = 11` in `𝔽₂₃`. -/
theorem forced_value_7_3 :
    -(25 : ZMod 23) / ((2 * qureshiSum 7 3 11 % 23 : ℕ) : ZMod 23) = 11 := by decide +kernel

/-- Example 5.3: `S_{66} = -371 / c_{(33)} = 33` in `𝔽₆₇`. -/
theorem forced_value_26_3 :
    -(371 : ZMod 67) / ((2 * qureshiSum 26 3 33 % 67 : ℕ) : ZMod 67) = 33 := by decide +kernel

set_option exponentiation.threshold 400 in
/-- Example 5.10: `S_{366} = -9 / c_{(183)} = 103` in `𝔽₃₆₇`. -/
theorem forced_value_13_3 :
    -(9 : ZMod 367) / ((2 * qureshiSum 13 3 183 % 367 : ℕ) : ZMod 367) = 103 := by decide +kernel

/-- Example 5.7: `S_{148} = -4669 / c_{(74)} = 63` in `𝔽₁₄₉`, and `c_{(41)} ≡ 0 (mod 149)`. -/
theorem forced_value_80_3 :
    -(4669 : ZMod 149) / ((2 * qureshiSum 80 3 74 % 149 : ℕ) : ZMod 149) = 63 ∧
      2 * qureshiSum 80 3 41 % 149 = 0 := by decide +kernel

/-! ### Numerical data quoted in the remaining (computer-assisted) examples

These only check the sizes of Lee balls quoted in the manuscript; the computer searches
themselves are not reproduced. -/

/-- Example 5.6: `|B⁷⁹(3)| = 670079 = 269 · 53 · 47`, `m = 2491`, and `|B¹⁹(3)| = 9919 > m`. -/
theorem card_leeBall_example_5_6 :
    (leeBall 79 3).card = 670079 ∧ 670079 = 269 * 53 * 47 ∧ 670079 = 2491 * 269 ∧
      (leeBall 19 3).card = 9919 ∧ 2491 < 9919 := by
  simp only [card_leeBall, stantonCowan_eq_scFast]; decide

/-- Proposition 5.12 (`n = 84`): `|B⁸⁴(3)| = 23² · 13² · 3²`, and `m = 34983` for `p = 23`. -/
theorem card_leeBall_84_3 :
    (leeBall 84 3).card = 23 ^ 2 * 13 ^ 2 * 3 ^ 2 ∧ 23 ^ 2 * 13 ^ 2 * 3 ^ 2 = 34983 * 23 := by
  simp only [card_leeBall, stantonCowan_eq_scFast]; decide

/-- Example 5.13: `|B⁸⁰⁵(3)| = 696845031 = 3 · 29² · 179 · 1543`. -/
theorem card_leeBall_805_3 :
    (leeBall 805 3).card = 696845031 ∧ 696845031 = 3 * 29 ^ 2 * 179 * 1543 := by
  simp only [card_leeBall, stantonCowan_eq_scFast]; decide

end LeeBall
