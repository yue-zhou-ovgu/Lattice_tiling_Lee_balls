module

public import RequestProject.LeeBall.Section5

/-!
# Proposition 5.11: reducing the recursion for `S_{2k}`
-/

@[expose] public section

open Finset

namespace LeeBall

/-- `c_λ = 0` whenever `ℓ(λ) > r` (first step of the proof of Proposition 5.11). -/
theorem cInt_eq_zero_of_length {n r k : ℕ} (q : k.Partition) (hq : r < q.parts.card) :
    cInt n r q = 0 := by
  have : compositions (partList q).length r = ∅ := by
    rw [Finset.eq_empty_iff_forall_notMem]
    intro c hc
    unfold compositions at hc
    rw [Finset.mem_filter, Finset.Nat.mem_antidiagonalTuple] at hc
    obtain ⟨hsum, hpos⟩ := hc
    rw [Fin.sum_univ_castSucc] at hsum
    have : (partList q).length ≤ ∑ j : Fin (partList q).length, c j.castSucc := by
      calc (partList q).length = ∑ _j : Fin (partList q).length, 1 := by simp
        _ ≤ _ := Finset.sum_le_sum fun j _ => hpos j
    have hlen := length_partList q
    omega
  simp [cInt, compSum, this]

variable {n r m p : ℕ}

/-- The additive monoid `B` generated by `A = {k ∈ [1, h] : c_{(k)} ≡ 0 (mod p)}`. -/
def badMonoid (n r p : ℕ) : AddSubmonoid ℕ :=
  AddSubmonoid.closure {k | 1 ≤ k ∧ k ≤ (p - 1) / 2 ∧
    (cInt n r (Nat.Partition.indiscrete k) : ZMod p) = 0}

lemma sum_mem_badMonoid {k : ℕ} (q : k.Partition) (hq : ∀ j ∈ q.parts, j ∈ badMonoid n r p) :
    k ∈ badMonoid n r p := by
  rw [← q.parts_sum]
  exact AddSubmonoid.multiset_sum_mem _ _ hq

open Classical in
/-- In `f_k(Y)` only the term `λ = (k)` and the partitions in `K_k` (length `≤ r`, all parts in
`B`) can contribute, once `Y_j = 0` for the indices `j < k` outside `B`. -/
lemma fY_eq_reduced [Fact p.Prime] {k : ℕ} (hk : 1 ≤ k) (Y : ℕ → ZMod p)
    (hY : ∀ j, 1 ≤ j → j < k → j ∉ badMonoid n r p → Y j = 0) :
    fY n r p k Y = (cInt n r (Nat.Partition.indiscrete k) : ZMod p) * Y k +
      ∑ q ∈ univ.filter (fun q : k.Partition => q ≠ Nat.Partition.indiscrete k ∧
        q.parts.card ≤ r ∧ ∀ j ∈ q.parts, j ∈ badMonoid n r p),
        (cInt n r q : ZMod p) * (q.parts.map Y).prod := by
  rw [fY, ← Finset.add_sum_erase _ _ (Finset.mem_univ (Nat.Partition.indiscrete k)),
    Nat.Partition.indiscrete_parts (by omega)]
  simp only [Multiset.map_singleton, Multiset.prod_singleton]
  congr 1
  rw [← Finset.sum_filter_add_sum_filter_not (univ.erase _)
    (fun q : k.Partition => q.parts.card ≤ r ∧ ∀ j ∈ q.parts, j ∈ badMonoid n r p)]
  have h0 : ∑ q ∈ (univ.erase (Nat.Partition.indiscrete k)).filter
      (fun q : k.Partition => ¬ (q.parts.card ≤ r ∧ ∀ j ∈ q.parts, j ∈ badMonoid n r p)),
      (cInt n r q : ZMod p) * (q.parts.map Y).prod = 0 := by
    refine Finset.sum_eq_zero fun q hq => ?_
    simp only [mem_filter, mem_erase, mem_univ, and_true, not_and_or, not_le, not_forall]
      at hq
    rcases hq.2 with hlen | ⟨j, hj, hjB⟩
    · rw [cInt_eq_zero_of_length q hlen]; simp
    · have hjk : j < k := lt_of_le_of_ne (q.le_of_mem_parts hj)
        (fun h => hq.1 (partition_eq_indiscrete_of_mem q (h ▸ hj)))
      rw [Multiset.prod_eq_zero (Multiset.mem_map.2 ⟨j, hj, hY j (q.parts_pos hj) hjk hjB⟩),
        mul_zero]
  rw [h0, add_zero, Finset.filter_erase]
  refine Finset.sum_congr ?_ fun _ _ => rfl
  ext q; simp [and_comm, and_assoc]

/-- **Proposition 5.11** (vanishing part).  Let `Y` solve the system of Theorem 4.3
(e.g. `Y_k = S_{2k}`).  If `1 ≤ k ≤ h = (p-1)/2` and `k ∉ B`, then `Y_k = 0` for
`k < h`, and `Y_h = -m / c_{(h)}` for `k = h`. -/
theorem ySystem_vanish [Fact p.Prime] {Y : ℕ → ZMod p} (hY : YSystem n r m p Y) :
    ∀ k, 1 ≤ k → k ≤ (p - 1) / 2 → k ∉ badMonoid n r p →
      (k < (p - 1) / 2 → Y k = 0) ∧
      (k = (p - 1) / 2 → Y k = -(m : ZMod p) / (cInt n r (Nat.Partition.indiscrete k))) := by
  intro k
  induction k using Nat.strong_induction_on with
  | _ k ih =>
    intro hk1 hkh hkB
    have hc : (cInt n r (Nat.Partition.indiscrete k) : ZMod p) ≠ 0 := fun h0 =>
      hkB (AddSubmonoid.subset_closure ⟨hk1, hkh, h0⟩)
    have hred : fY n r p k Y = (cInt n r (Nat.Partition.indiscrete k) : ZMod p) * Y k := by
      rw [fY_eq_reduced hk1 Y fun j hj1 hjk hjB => (ih j hjk hj1 (by omega) hjB).1 (by omega)]
      rw [Finset.sum_eq_zero, add_zero]
      intro q hq
      simp only [mem_filter, mem_univ, true_and] at hq
      exact absurd (sum_mem_badMonoid q hq.2.2) hkB
    refine ⟨fun hlt => ?_, fun heq => ?_⟩
    · have := hY.1 k hk1 hlt
      rw [hred] at this
      exact (mul_eq_zero.1 this).resolve_left hc
    · have := hY.2
      rw [← heq, hred] at this
      rw [← this, mul_div_cancel_left₀ _ hc]

open Classical in
/-- **Proposition 5.11** (reduced recursion, equation `P6-computeS2k`).  For `k ∉ A`
(`c_{(k)} ≢ 0`), with `K_k` the partitions `λ ≠ (k)` of `k` with `ℓ(λ) ≤ r` and all parts in `B`:
`Y_k = -(∑_{λ ∈ K_k} c_λ Y_λ) / c_{(k)}` if `k < h`, and
`Y_h = -(m + ∑_{λ ∈ K_h} c_λ Y_λ) / c_{(h)}`. -/
theorem ySystem_reduced [Fact p.Prime] {Y : ℕ → ZMod p} (hY : YSystem n r m p Y) {k : ℕ}
    (hk1 : 1 ≤ k) (hkh : k ≤ (p - 1) / 2)
    (hc : (cInt n r (Nat.Partition.indiscrete k) : ZMod p) ≠ 0) :
    let K := ∑ q ∈ univ.filter (fun q : k.Partition => q ≠ Nat.Partition.indiscrete k ∧
        q.parts.card ≤ r ∧ ∀ j ∈ q.parts, j ∈ badMonoid n r p),
        (cInt n r q : ZMod p) * (q.parts.map Y).prod
    (k < (p - 1) / 2 → Y k = -K / cInt n r (Nat.Partition.indiscrete k)) ∧
    (k = (p - 1) / 2 → Y k = -((m : ZMod p) + K) / cInt n r (Nat.Partition.indiscrete k)) := by
  intro K
  have hred := fY_eq_reduced (n := n) (r := r) (p := p) hk1 Y fun j hj1 hjk hjB =>
    (ySystem_vanish hY j hj1 (by omega) hjB).1 (by omega)
  refine ⟨fun hlt => ?_, fun heq => ?_⟩
  · have h0 := hY.1 k hk1 hlt
    rw [hred] at h0
    field_simp
    linear_combination h0
  · have h0 := hY.2
    rw [← heq, hred] at h0
    field_simp
    linear_combination h0


/-! ### The bound `|K_k| ≤ ∑_{j=2}^r C(k-1, j-1)` -/


lemma card_boundaries_symm {k : ℕ} (hk : 1 ≤ k) (s : Finset (Fin (k - 1))) :
    ((compositionAsSetEquiv k).symm s).boundaries.card = s.card + 2 := by
  let e : Fin (k - 1) ↪ Fin k.succ := ⟨fun j => ⟨j + 1, by omega⟩, fun a b h => by
    simp only [Fin.mk.injEq, add_left_inj] at h; exact Fin.ext h⟩
  have hb : ((compositionAsSetEquiv k).symm s).boundaries =
      insert 0 (insert (Fin.last k) (s.map e)) := by
    ext i
    simp only [compositionAsSetEquiv, Equiv.coe_fn_symm_mk, Set.toFinset_setOf, mem_filter,
      mem_univ, true_and, exists_prop, mem_insert, mem_map]
    constructor
    · rintro (h | h | ⟨j, hj, hij⟩)
      · exact Or.inl h
      · exact Or.inr (Or.inl h)
      · exact Or.inr (Or.inr ⟨j, hj, Fin.ext (by simp [e, hij])⟩)
    · rintro (h | h | ⟨j, hj, rfl⟩)
      · exact Or.inl h
      · exact Or.inr (Or.inl h)
      · exact Or.inr (Or.inr ⟨j, hj, rfl⟩)
  rw [hb, card_insert_of_notMem, card_insert_of_notMem, card_map]
  · simp only [mem_map, not_exists, not_and]
    intro j _ h
    have := congrArg Fin.val h
    simp [e] at this; omega
  · simp only [mem_insert, mem_map, not_or, not_exists, not_and]
    refine ⟨fun h => ?_, fun j _ h => ?_⟩
    · have := congrArg Fin.val h; simp at this; omega
    · have := congrArg Fin.val h; simp [e] at this

lemma card_compositionAsSet_length_le {k : ℕ} (hk : 1 ≤ k) (j : ℕ) :
    (univ.filter fun c : CompositionAsSet k => c.length = j).card ≤ (k - 1).choose (j - 1) := by
  rw [← Finset.card_fin (k - 1), ← Finset.card_powersetCard]
  refine Finset.card_le_card_of_injOn (compositionAsSetEquiv k) (fun c hc => ?_)
    (compositionAsSetEquiv k).injective.injOn
  simp only [coe_filter, mem_univ, true_and, Set.mem_setOf_eq] at hc
  simp only [mem_coe, mem_powersetCard, subset_univ, true_and]
  have h := card_boundaries_symm hk (compositionAsSetEquiv k c)
  rw [Equiv.symm_apply_apply, c.card_boundaries_eq_succ_length] at h
  omega

lemma card_partition_length_le {k : ℕ} (hk : 1 ≤ k) (j : ℕ) :
    (univ.filter fun q : k.Partition => q.parts.card = j).card ≤ (k - 1).choose (j - 1) := by
  calc _ ≤ ((univ.filter fun c : Composition k => c.length = j).image
          (Nat.Partition.ofComposition k)).card := by
        refine card_le_card fun q hq => ?_
        obtain ⟨c, rfl⟩ := Nat.Partition.ofComposition_surj q
        simp only [mem_filter, mem_univ, true_and, Nat.Partition.ofComposition_parts,
          Multiset.coe_card] at hq
        exact mem_image.2 ⟨c, by simpa [Composition.length] using hq, rfl⟩
    _ ≤ (univ.filter fun c : Composition k => c.length = j).card := card_image_le
    _ = (univ.filter fun c : CompositionAsSet k => c.length = j).card := by
        refine Finset.card_bij (fun c _ => compositionEquiv k c) (fun c hc => ?_)
          (fun a _ b _ h => (compositionEquiv k).injective h) (fun c hc => ?_)
        · simp only [mem_filter, mem_univ, true_and] at hc ⊢
          simpa [compositionEquiv, Composition.toCompositionAsSet_length] using hc
        · refine ⟨(compositionEquiv k).symm c, ?_, by simp⟩
          simp only [mem_filter, mem_univ, true_and] at hc ⊢
          rw [← Composition.toCompositionAsSet_length]
          simpa [compositionEquiv] using hc
    _ ≤ _ := card_compositionAsSet_length_le hk j

lemma two_le_card_of_ne_indiscrete {k : ℕ} (hk : 1 ≤ k) (q : k.Partition)
    (hq : q ≠ Nat.Partition.indiscrete k) : 2 ≤ q.parts.card := by
  by_contra h
  interval_cases hc : q.parts.card
  · rw [Multiset.card_eq_zero] at hc
    have := q.parts_sum; rw [hc] at this; simp at this; omega
  · obtain ⟨a, ha⟩ := Multiset.card_eq_one.1 hc
    apply hq
    ext1
    rw [Nat.Partition.indiscrete_parts (by omega), ha]
    have := q.parts_sum; rw [ha] at this; simp at this; rw [this]

open Classical in
theorem card_K_le_aux {k : ℕ} (hk : 1 ≤ k) (r : ℕ) (P : ℕ → Prop) :
    (univ.filter (fun q : k.Partition => q ≠ Nat.Partition.indiscrete k ∧
        q.parts.card ≤ r ∧ ∀ j ∈ q.parts, P j)).card ≤
      ∑ j ∈ Icc 2 r, (k - 1).choose (j - 1) := by
  calc _ ≤ ((Icc 2 r).biUnion (fun j => univ.filter fun q : k.Partition => q.parts.card = j)).card := by
        refine card_le_card fun q hq => ?_
        simp only [mem_filter, mem_univ, true_and] at hq
        simp only [mem_biUnion, mem_Icc, mem_filter, mem_univ, true_and]
        exact ⟨_, ⟨two_le_card_of_ne_indiscrete hk q hq.1, hq.2.1⟩, rfl⟩
    _ ≤ ∑ j ∈ Icc 2 r, (univ.filter fun q : k.Partition => q.parts.card = j).card :=
        card_biUnion_le
    _ ≤ _ := sum_le_sum fun j _ => card_partition_length_le hk j

open Classical in
/-- **Proposition 5.11** (size bound): `|K_k| ≤ ∑_{j=2}^r C(k-1, j-1)`. -/
theorem card_K_le {k : ℕ} (hk : 1 ≤ k) :
    (univ.filter (fun q : k.Partition => q ≠ Nat.Partition.indiscrete k ∧
        q.parts.card ≤ r ∧ ∀ j ∈ q.parts, j ∈ badMonoid n r p)).card ≤
      ∑ j ∈ Icc 2 r, (k - 1).choose (j - 1) :=
  card_K_le_aux hk r _

end LeeBall
